local viewerRelationshipUtils = require(script.Parent.viewerRelationshipUtils)

local function getFriendStatusFromProfileResponse(p)
	local viewerRelationshipFromProfileResponse = viewerRelationshipUtils.getViewerRelationshipFromProfileResponse(p)
	local contextualInformationFromProfileResponse = viewerRelationshipUtils.getContextualInformationFromProfileResponse(p)
	return viewerRelationshipUtils.mapViewerRelationshipAndContextToAnalyticsFriendStatus(
		viewerRelationshipFromProfileResponse,
		contextualInformationFromProfileResponse
	)
end

return getFriendStatusFromProfileResponse
