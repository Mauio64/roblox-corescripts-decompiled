local CorePackages = game:GetService("CorePackages")
local t = require(CorePackages.Packages.t)
local FFlagFixOffSaleCurrentlyWearingItemNavigation = require(CorePackages.Workspace.Packages.SharedFlags).FFlagFixOffSaleCurrentlyWearingItemNavigation
local AvatarExperienceFlags = require(CorePackages.Workspace.Packages.AvatarExperienceFlags)
local FFlagAXInventoryDurablesSupport = AvatarExperienceFlags.FFlagAXInventoryDurablesSupport
local FFlagDynamicHeadsMigration = AvatarExperienceFlags.FFlagDynamicHeadsMigration
local FFlagAXAddHDRowInItemDetailsPage = AvatarExperienceFlags.FFlagAXAddHDRowInItemDetailsPage

return t.strictInterface({
	receivedCatalogData = t.optional(t.boolean),
	receivedRecommendedData = t.optional(t.boolean),
	receivedFromRecommendedData = t.optional(t.boolean),
	receivedFromBundleItemData = t.optional(t.boolean),
	receivedFromInventoryFetch = t.optional(t.boolean),
	receivedFromOutfitDetails = t.optional(t.boolean),
	receivedFromResaleData = t.optional(t.boolean),
	receivedFromSortResults = t.optional(t.boolean),
	receivedFromVersionData = t.optional(t.boolean),
	receivedBundleDetails = t.optional(t.boolean),
	receivedWidgetHydration = t.optional(t.boolean),
	name = t.string,
	id = t.string,
	description = t.optional(t.string),
	creatorName = t.optional(t.string),
	assetType = t.optional(t.string),
	bundleType = t.optional(t.string),
	itemType = t.optional(t.string),
	items = t.optional(t.array(t.strictInterface({
		owned = t.optional(t.boolean),
		id = t.string,
		name = t.optional(t.string),
		assetType = t.optional(t.string),
		type = t.string
	}))),
	priceInRobux = t.optional(t.integer),
	creator = t.optional(t.strictInterface({
		id = t.optional(t.string),
		name = t.optional(t.string),
		type = t.optional(t.string),
		targetId = t.optional(t.string),
		hasVerifiedBadge = t.optional(t.boolean)
	})),
	created = t.optional(t.string),
	updated = t.optional(t.string),
	genres = t.optional(t.array(t.string)),
	minimumMembershipLevel = t.optional(t.integer),
	premiumPricing = t.optional(t.strictInterface({
		premiumDiscountPercentage = t.optional(t.number),
		premiumPriceInRobux = t.optional(t.integer)
	})),
	product = t.optional(t.strictInterface({
		id = t.string,
		type = t.optional(t.string),
		isForSale = t.optional(t.boolean)
	})),
	recommendedItemSummaries = t.optional(t.array(t.strictInterface({
		id = t.string,
		type = t.string,
		subType = t.string,
		gridInformation = t.optional(t.table)
	}))),
	favoriteCount = t.optional(t.integer),
	priceStatus = t.optional(t.string),
	itemRestrictions = t.optional(t.map(t.string, t.boolean)),
	tileRestrictionsMap = t.optional(t.map(t.userdata, t.boolean)),
	itemStatus = t.optional(t.array(t.string)),
	lowestPrice = t.optional(t.integer),
	lowestResalePrice = t.optional(t.integer),
	numberRobloxHasAvailable = t.optional(t.integer),
	totalQuantity = t.optional(t.integer),
	resellerUserAssetIds = t.optional(t.array(t.string)),
	soldCount = t.optional(t.integer),
	averagePrice = t.optional(t.integer),
	originalPrice = t.optional(t.integer),
	discountInformation = t.optional(t.table),
	isForRent = t.optional(t.boolean),
	isOwned = t.optional(t.boolean),
	supportsHeadShapes = if not FFlagDynamicHeadsMigration then nil else t.optional(t.boolean),
	isPurchasable = t.optional(t.boolean),
	isPublicDomain = t.optional(t.boolean),
	isHighDefinition = if not FFlagAXAddHDRowInItemDetailsPage then nil else t.optional(t.boolean),
	isPBR = t.optional(t.boolean),
	expectedSellerId = t.optional(t.string),
	collectibleItemId = t.optional(t.string),
	saleLocationType = t.optional(t.string),
	hasResellers = t.optional(t.boolean),
	creatingUniverseId = t.optional(t.string),
	isRecolorable = t.optional(t.boolean),
	isOffSale = if not FFlagFixOffSaleCurrentlyWearingItemNavigation then nil else t.optional(t.boolean),
	variantAttributes = t.optional(t.table),
	relatedVariants = t.optional(t.table),
	timedOptions = t.optional(t.table),
	taxonomy = t.optional(t.table),
	moderationStatus = t.optional(t.enum(Enum.ModerationStatus)),
	updateCounter = t.optional(t.number),
	expirationTime = if not FFlagAXInventoryDurablesSupport then nil else t.optional(t.string)
})
