					if v5 ~= nil then
						for k, v6 in v5 do
							if p3[v6] ~= nil then
								return { kind = p3[v6], message = errorMessage }
							end
						end
					end
				end

				if p4 == nil or p4[responseCode] == nil then
					return { kind = verifyErrorKind.Unknown, message = errorMessage }
				end

				return { kind = p4[responseCode], message = errorMessage }
			end

