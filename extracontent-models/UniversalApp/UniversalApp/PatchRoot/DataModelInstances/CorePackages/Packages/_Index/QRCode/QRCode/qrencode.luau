local function get_version_eclevel(p, p2, value)
	local v3 = p2 == 4 and 3 or p2 == 8 and 4 or p2

	assert(v3 <= 4)

	local v4 = nil
	local v5 = {
		{ 10, 9, 8, 8 },
		{ 12, 11, 16, 10 },
		{ 14, 13, 16, 12 }
	}
	local v6 = 40
	local v7 = value or 1
	local v8 = 1
	local v9 = 4

	if value and value >= 1 and value <= 4 then
		v9 = value
		v8 = v9
	end

	for i = v8, v9 do
		for j = 1, #v2 do
			local v10 = v2[j][i] * 8 - 4

			if j < 10 then
				v4 = v5[1][v3]
			elseif j < 27 then
				v4 = v5[2][v3]
			elseif j <= 40 then
				v4 = v5[3][v3]
			end

			local v11 = v10 - v4
			local v12

			if v3 == 1 then
				v12 = math.floor(v11 * 3 / 10)
			elseif v3 == 2 then
				v12 = math.floor(v11 * 2 / 11)
			elseif v3 == 3 then
				v12 = math.floor(v11 * 1 / 8)
			else
				v12 = math.floor(v11 * 1 / 13)
			end

			if p <= v12 then
				if j <= v6 then
					v7 = i
					v6 = j
				end

				break
			end
		end
	end

	return v6, v7
end

