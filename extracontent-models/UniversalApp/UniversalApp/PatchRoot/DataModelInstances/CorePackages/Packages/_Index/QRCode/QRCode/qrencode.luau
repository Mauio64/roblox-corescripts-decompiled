local function tbl_to_number(list) -- 1 equivalent call inferred from this helper
	local v2 = 1
	local total = 0

	for i = 1, #list do
		total += list[i] * v2
		v2 *= 2
	end

	return total
end

local function bit_xor(p, p2)
	local v2 = v[p]
	local v3 = v[p2]
	local v4 = {}

	for i = 1, 8 do
		if v2[i] == v3[i] then
			v4[i] = 0
		else
			v4[i] = 1
		end
	end

	return tbl_to_number(v4) -- inferred equivalent call
end

local function binary(p, p2)
	local v2 = string.format("%o", p)
	local v3 = {
		["0"] = "000",
		["1"] = "001",
		["2"] = "010",
		["3"] = "011",
		["4"] = "100",
		["5"] = "101",
		["6"] = "110",
		["7"] = "111"
	}

	local v4 = string.gsub(v2, "(.)", function(p3)
		return v3[p3]
	end)

	local v5 = string.gsub(v4, "^0*(.*)$", "%1")
	local v6 = string.format("%%%ds", p2)
	local v7 = string.format(v6, v5)
	return string.gsub(v7, " ", "0")
end

