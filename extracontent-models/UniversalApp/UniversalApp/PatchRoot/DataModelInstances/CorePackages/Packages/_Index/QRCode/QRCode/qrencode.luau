end

local function get_pixel_with_mask(p, p2, p3, p4)
	p2 -= 1
	p3 -= 1
	local v11 = false

	if p ~= -1 then
		if p == 0 then
			v11 = math.fmod(p2 + p3, 2) == 0 or false
		elseif p == 1 then
			v11 = math.fmod(p3, 2) == 0 or false
		elseif p == 2 then
			v11 = math.fmod(p2, 3) == 0 or false
		elseif p == 3 then
			v11 = math.fmod(p2 + p3, 3) == 0 or false
		elseif p == 4 then
			v11 = math.fmod(math.floor(p3 / 2) + math.floor(p2 / 3), 2) == 0 or false
		elseif p == 5 then
			v11 = math.fmod(p2 * p3, 2) + math.fmod(p2 * p3, 3) == 0 or false
		elseif p == 6 then
			v11 = math.fmod(math.fmod(p2 * p3, 2) + math.fmod(p2 * p3, 3), 2) == 0 or false
		elseif p == 7 then
			v11 = math.fmod(math.fmod(p2 * p3, 3) + math.fmod(p2 + p3, 2), 2) == 0 or false
		else
			assert(false, "This can't happen (mask must be <= 7)")
		end
	end

	if v11 then
		return 1 - tonumber(p4) * 2
	end

	return tonumber(p4) * 2 + -1
end

local function get_next_free_positions(list, p, p2, p3, value)
	local v11 = 1
	local v12 = "right"
	local result = {}

	while v11 <= #value do
		if v12 == "right" and list[p][p2] == 0 then
			result[#result + 1] = { p, p2 }

			v11 += 1
			v12 = "left"
		else
			if v12 == "left" and list[p - 1][p2] == 0 then
				result[#result + 1] = { p - 1, p2 }
				v12 = "right"
				v11 += 1
			elseif v12 == "right" and list[p - 1][p2] == 0 then
				result[#result + 1] = { p - 1, p2 }
				v11 += 1
			end

			if p3 == "up" then
				p2 -= 1
			else
				p2 += 1
			end
		end

		if not (p2 < 1 or #list < p2) then
			continue
		end

		p -= 2

		p = p == 7 and 6 or p

		if p3 == "up" then
			p3 = "down"
			p2 = 1
		else
			p2 = #list
			p3 = "up"
		end
	end

	return result, p, p2, p3
end

local function add_data_to_matrix(list, value, p) -- 1 equivalent call inferred from this helper
	size = #list
	local v11 = nil
	local v12 = nil
	local v13 = nil
	local v14 = nil
	local v15 = "up"
	local count = 0
	local v16 = size
	local v17 = size
	string.gsub(value, ".?.?.?.?.?.?.?.?", function(value2)
		count += 1
		v11, v16, v17, v15 = get_next_free_positions(list, v16, v17, v15, value2, p)

		for i = 1, #value2 do
			v12 = v11[i][1]
			v13 = v11[i][2]
			v14 = get_pixel_with_mask(p, v12, v13, string.sub(value2, i, i))

			if debugging then
				list[v12][v13] = v14 * (i + 10)
			else
				list[v12][v13] = v14
			end
		end
	end)
end

local function calculate_penalty(list)
	local count = #list
	local count2 = 0
	local v11 = 0
	local total = 0
	local total2 = 0

	for i = 1, count do
		local v12 = nil
		local v13 = 0

		for j = 1, count do
			if list[i][j] > 0 then
				count2 += 1
			end

			local v14 = list[i][j] < 0

			if v12 == v14 then
				v13 += 1
			else
				if v13 >= 5 then
					v11 = v11 + v13 - 2
				end

				v13 = 1
			end

			v12 = v14
		end

		if v13 >= 5 then
			v11 = v11 + v13 - 2
		end
	end

	for i = 1, count do
		local v12 = nil
		local v13 = 0

		for j = 1, count do
			local v14 = list[j][i] < 0

			if v12 == v14 then
				v13 += 1
			else
				if v13 >= 5 then
					v11 = v11 + v13 - 2
				end

				v13 = 1
			end

			v12 = v14
		end

		if v13 >= 5 then
			v11 = v11 + v13 - 2
		end
	end

	for i = 1, count do
		for j = 1, count do
			if
				j < count - 1
				and i < count - 1
				and (list[i][j] < 0 and list[i + 1][j] < 0 and list[i][j + 1] < 0 and list[i + 1][j + 1] < 0 or list[i][j] > 0 and list[i + 1][j] > 0 and list[i][j + 1] > 0 and list[i + 1][j + 1] > 0)
			then
				total += 3
			end

			if
				j + 6 < count
				and list[i][j] > 0
				and list[i][j + 1] < 0
				and list[i][j + 2] > 0
				and list[i][j + 3] > 0
				and list[i][j + 4] > 0
				and list[i][j + 5] < 0
				and list[i][j + 6] > 0
				and (j + 10 < count and list[i][j + 7] < 0 and list[i][j + 8] < 0 and list[i][j + 9] < 0 and list[i][j + 10] < 0 or j - 4 >= 1 and list[i][j - 1] < 0 and list[i][j - 2] < 0 and list[i][j - 3] < 0 and list[i][j - 4] < 0)
			then
				total2 += 40
			end

			if not (i + 6 <= count and list[i][j] > 0 and list[i + 1][j] < 0 and list[i + 2][j] > 0) then
				continue
			end

			if not (list[i + 3][j] > 0 and list[i + 4][j] > 0 and list[i + 5][j] < 0 and list[i + 6][j] > 0) then
				continue
			end

			if not (i + 10 <= count and list[i + 7][j] < 0 and list[i + 8][j] < 0 and list[i + 9][j] < 0 and list[i + 10][j] < 0 or i - 4 >= 1 and list[i - 1][j] < 0 and list[i - 2][j] < 0 and list[i - 3][j] < 0 and list[i - 4][j] < 0) then
				continue
			end

			total2 += 40
		end
	end

	local v12 = math.floor((math.abs(count2 / (count * count) * 100 - 50))) * 2
	return v11 + total + total2 + v12
end

local function get_matrix_and_penalty(p, p2, value, i) -- 1 equivalent call inferred from this helper
	local v11 = prepare_matrix_with_mask(p, p2, i)
	add_data_to_matrix(v11, value, i) -- inferred equivalent call
	return v11, calculate_penalty(v11)
end

local function get_matrix_with_lowest_penalty(p, p2, value)
	local v11 = prepare_matrix_with_mask(p, p2, 0)
	size = #v11
	local v12 = nil
	local v13 = nil
	local v14 = nil
	local v15 = nil
	local v16 = "up"
	local count = 0
	local v17 = size
	local v18 = size
	local v19 = 0
	string.gsub(value, ".?.?.?.?.?.?.?.?", function(value2)
		count += 1
		v12, v17, v18, v16 = get_next_free_positions(v11, v17, v18, v16, value2, v19)

		for i = 1, #value2 do
			v13 = v12[i][1]
			v14 = v12[i][2]
			v15 = get_pixel_with_mask(v19, v13, v14, string.sub(value2, i, i))

			if debugging then
				v11[v13][v14] = v15 * (i + 10)
			else
				v11[v13][v14] = v15
			end
		end
	end)

	local v20 = calculate_penalty(v11)
	local v21 = v11

	for i = 1, 7 do
		local v22, v23 = get_matrix_and_penalty(p, p2, value, i) -- inferred equivalent call

		if not (v23 < v20) then
			continue
		end

		v21 = v22
		v20 = v23
	end

	return v21
end

local Qrencode = {}
