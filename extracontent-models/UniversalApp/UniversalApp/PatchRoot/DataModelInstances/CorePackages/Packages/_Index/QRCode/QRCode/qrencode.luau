local function arrange_codewords_and_calculate_ec(p, p2, value)
	if type(value) == "table" then
		local v8 = ""

		for i = 1, #value do
			v8 ..= binary(value[i], 8)
		end

		value = v8
	end

	local v8 = v7[p][p2]
	local total = 0
	local v9 = {}
	local total2 = 0
	local tmp_strs = {}
	local v10 = 1

	for i = 1, #v8 / 2 do
		for _ = 1, v8[i * 2 - 1] do
			local v11 = v8[i * 2][2]
			local v12 = v8[i * 2][1] - v8[i * 2][2]
			total += v12 * 8
			v9[#v9 + 1] = string.sub(value, total2 * 8 + 1, (total2 + v11) * 8)
			tmp_tab = calculate_error_correction(v9[#v9], v12)
			tmp_str = ""

			for j = 1, #tmp_tab do
				tmp_str ..= binary(tmp_tab[j], 8)
			end

			tmp_strs[#tmp_strs + 1] = tmp_str
			total2 += v11
			v10 += 1
		end
	end

	local total3 = 1
	local v11 = ""

	repeat
		for i = 1, #v9 do
			if total3 < #v9[i] then
				v11 ..= string.sub(v9[i], total3, total3 + 7)
			end
		end

		total3 += 8
	until #v11 == #value

	local total4 = 1
	local v12 = ""

	repeat
		for i = 1, #tmp_strs do
			if total4 < #tmp_strs[i] then
				v12 ..= string.sub(tmp_strs[i], total4, total4 + 7)
			end
		end

		total4 += 8
	until #v12 == total

	return v11 .. v12
end

local function add_position_detection_patterns(list)
	local count = #list

	for i = 1, 8 do
		for j = 1, 8 do
			list[i][j] = -2
			list[count - 8 + i][j] = -2
			list[i][count - 8 + j] = -2
		end
	end

	for i = 1, 7 do
		list[1][i] = 2
		list[7][i] = 2
		list[i][1] = 2
		list[i][7] = 2

		list[count][i] = 2
		list[count - 6][i] = 2
		list[count - i + 1][1] = 2
		list[count - i + 1][7] = 2

		list[1][count - i + 1] = 2
		list[7][count - i + 1] = 2
		list[i][count - 6] = 2
		list[i][count] = 2
	end

	for i = 1, 3 do
		for j = 1, 3 do
			list[j + 2][i + 2] = 2

			list[count - j - 1][i + 2] = 2

			list[j + 2][count - i - 1] = 2
		end
	end
end

local function add_timing_pattern(list)
	local v8 = 9
	local v9 = 7

	for i = v8, #list - 8 do
		if math.fmod(i, 2) == 1 then
			list[i][v9] = 2
		else
			list[i][v9] = -2
		end
	end

	for i = v8, #list - 8 do
		if math.fmod(i, 2) == 1 then
			list[v9][i] = 2
		else
			list[v9][i] = -2
		end
	end
end

