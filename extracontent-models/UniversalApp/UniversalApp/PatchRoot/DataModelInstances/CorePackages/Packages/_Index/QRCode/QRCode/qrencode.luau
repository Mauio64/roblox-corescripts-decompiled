local function get_generator_polynominal_adjusted(p, p2)
	local result = { [0] = 0 }

	for i = 0, p2 - p - 1 do
		result[i] = 0
	end

	local v7 = v6[p]

	for i = 1, p + 1 do
		result[p2 - p + i - 1] = v7[i]
	end

	return result
end

local function convert_to_alpha(list)
	local result = {}

	for i = 0, #list do
		result[i] = v5[list[i]]
	end

	return result
end

local function convert_to_int(list, _) -- 2 equivalent calls inferred from this helper
	local result = {}

	for i = 0, #list do
		result[i] = v4[list[i]]
	end

	return result
end

local function calculate_error_correction(value, p)
	local v7 = nil

	if type(value) == "string" then
		v7 = {}
		string.gsub(value, "(........)", function(p2)
			v7[#v7 + 1] = tonumber(p2, 2)
		end)
	elseif type(value) == "table" then
		v7 = value
	else
		assert(false, "Unknown type for data: %s", (type(value)))
	end

	local count = #v7

	local v8 = count + p - 1

	local v9 = {}

	for i = 1, count do
		v9[v8 - i + 1] = v7[i]
	end

	for i = 1, v8 - count do
		v9[i] = 0
	end

	v9[0] = 0
	local v10 = {}

	for i = 0, #v9 do
		v10[i] = v5[v9[i]]
	end

	while p <= v8 do
		local v11 = get_generator_polynominal_adjusted(p, v8)

		local v12 = v10[v8]

		for i = v8, v8 - p, -1 do
			if v12 == 256 then
				v11[i] = 256
			elseif v11[i] + v12 >= 255 then
				v11[i] = math.fmod(v11[i] + v12, 255)
			else
				v11[i] += v12
			end
		end

		for i = v8 - p - 1, 0, -1 do
			v11[i] = 256
		end

		local result = convert_to_int(v11) -- inferred equivalent call
		local result2 = convert_to_int(v10) -- inferred equivalent call
		v9 = {}

		for i = v8, 0, -1 do
			v9[i] = bit_xor(result[i], result2[i])
		end

		for i = v8, 0, -1 do
			if i < p or v9[i] ~= 0 then
				break
			end

			v9[i] = nil
			v8 -= 1
		end

		v10 = {}

		for i = 0, #v9 do
			v10[i] = v5[v9[i]]
		end
	end

	local result = {}

	for i = #v9, 0, -1 do
		result[#result + 1] = v9[i]
	end

	return result
end

