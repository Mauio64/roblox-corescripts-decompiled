local function encode_string_numeric(value) -- 1 equivalent call inferred from this helper
	local v4 = ""
	local v5 = nil
	string.gsub(value, "..?.?", function(list)
		v5 = tonumber(list)

		if #list == 3 then
			v4 ..= binary(v5, 10)
		elseif #list == 2 then
			v4 ..= binary(v5, 7)
		else
			v4 ..= binary(v5, 4)
		end
	end)
	return v4
end

local function encode_string_ascii(value) -- 1 equivalent call inferred from this helper
	local v4 = ""
	local v5 = nil
	local v6 = nil
	local v7 = nil
	string.gsub(value, "..?", function(value2)
		if #value2 == 2 then
			v6 = v3[string.byte((string.sub(value2, 1, 1)))]
			v7 = v3[string.byte((string.sub(value2, 2, 2)))]
			v5 = v6 * 45 + v7
			v4 ..= binary(v5, 11)
		else
			v5 = v3[string.byte(value2)]
			v4 ..= binary(v5, 6)
		end
	end)
	return v4
end

local function encode_string_binary(value)
	local v4 = {}
	string.gsub(value, ".", function(value2)
		v4[#v4 + 1] = binary(string.byte(value2), 8)
	end)
	return table.concat(v4)
end

local function encode_data(list, p) -- 1 equivalent call inferred from this helper
	if p == 1 then
		return encode_string_numeric(list) -- inferred equivalent call
	elseif p == 2 then
		return encode_string_ascii(list) -- inferred equivalent call
	else
		if p == 4 then
			return encode_string_binary(list)
		end

		assert(false, "not implemented yet")
	end
end

local function add_pad_data(p, p2, list)
	local v4 = v2[p][p2] * 8
	local v5 = math.min(4, v4 - #list)

	if v5 > 0 then
		list ..= string.rep("0", v5)
	end

	if math.fmod(#list, 8) ~= 0 then
		local v6 = 8 - math.fmod(#list, 8)
		list ..= string.rep("0", v6)
	end

	assert(math.fmod(#list, 8) == 0)

	while #list < v4 do
		list ..= "11101100"

		if #list < v4 then
			list ..= "00010001"
		end
	end

	return list
end

