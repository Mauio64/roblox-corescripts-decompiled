local location = require(script.location)
local printLocation = require(script.printLocation)
local kinds = require(script.kinds)
local tokenKind = require(script.tokenKind)
local parser = require(script.parser)
local visitor = require(script.visitor)
local ast = require(script.ast)
local predicates = require(script.predicates)
local directiveLocation = require(script.directiveLocation)
local source = require(script.source)

local lexer = require(script.lexer)

local Language = {
	Source = source.Source,
	getLocation = location.getLocation,
	printLocation = printLocation.printLocation,
	printSourceLocation = printLocation.printSourceLocation,
	Kind = kinds.Kind,
	TokenKind = tokenKind.TokenKind,
	Lexer = lexer.Lexer,
	parse = parser.parse,
	parseValue = parser.parseValue,
	parseType = parser.parseType,
	print = 0,
	visit = 0,
	visitInParallel = 0,
	getVisitFn = 0,
	BREAK = 0,
	REMOVE = 0,
	Location = 0,
	Token = 0,
	isDefinitionNode = 0,
	isExecutableDefinitionNode = 0,
	isSelectionNode = 0,
	isValueNode = 0,
	isTypeNode = 0,
	isTypeSystemDefinitionNode = 0,
	isTypeDefinitionNode = 0,
	isTypeSystemExtensionNode = 0,
	isTypeExtensionNode = 0,
	DirectiveLocation = 0
}
local printer = require(script.printer)
Language.print = printer.print
Language.visit = visitor.visit
Language.visitInParallel = visitor.visitInParallel
Language.getVisitFn = visitor.getVisitFn
Language.BREAK = visitor.BREAK
Language.REMOVE = visitor.REMOVE
Language.Location = ast.Location
Language.Token = ast.Token
Language.isDefinitionNode = predicates.isDefinitionNode
Language.isExecutableDefinitionNode = predicates.isExecutableDefinitionNode
Language.isSelectionNode = predicates.isSelectionNode
Language.isValueNode = predicates.isValueNode
Language.isTypeNode = predicates.isTypeNode
Language.isTypeSystemDefinitionNode = predicates.isTypeSystemDefinitionNode
Language.isTypeDefinitionNode = predicates.isTypeDefinitionNode
Language.isTypeSystemExtensionNode = predicates.isTypeSystemExtensionNode
Language.isTypeExtensionNode = predicates.isTypeExtensionNode
Language.DirectiveLocation = directiveLocation.DirectiveLocation
return Language
